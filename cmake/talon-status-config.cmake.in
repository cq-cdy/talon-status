@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/talon-status-targets.cmake")

foreach(talon_status_component IN LISTS talon-status_FIND_COMPONENTS)
  if(talon_status_component STREQUAL "absl")
    include(CMakeFindDependencyMacro)
    find_dependency(absl CONFIG)
    if(NOT TARGET talon::status_absl)
      add_library(talon::status_absl INTERFACE IMPORTED)
      set_target_properties(talon::status_absl PROPERTIES
        INTERFACE_LINK_LIBRARIES "talon::status;absl::status;absl::statusor")
    endif()
    set(talon-status_absl_FOUND TRUE)
  else()
    set(talon-status_${talon_status_component}_FOUND FALSE)
    set(talon-status_NOT_FOUND_MESSAGE "Unknown talon-status component: ${talon_status_component}")
  endif()
endforeach()
check_required_components(talon-status)
